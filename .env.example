# Paramètres du serveur. Copiez ce fichier en « .env » (même dossier) et remplissez les valeurs utiles :
# « npm start » le lit au démarrage. Une ligne vide ou absente garde la valeur par défaut.
# Le fichier .env n’est jamais commité (il contient la clé hôte).

# Clé de la Régie (/host?key=…). Vide : une clé aléatoire à chaque démarrage, affichée dans la console.
HOST_KEY=

# Port du serveur. Par défaut : 3000. Si vous le changez, adaptez la Redirect URI de l’app Spotify.
PORT=

# Client ID de l’app Spotify (developer.spotify.com). Facultatif : il peut aussi être saisi dans la page Création.
SPOTIFY_CLIENT_ID=

# Dossiers et fichiers de données. Par défaut : à côté de server.js. Les chemins peuvent contenir des espaces.
PARTIES_DIR=
MUSIQUES_DIR=
IMAGES_DIR=
SCORES_FILE=
SPOTIFY_FILE=
